{
  "name": "wexample/symfony-dev-ds",
  "description": "Design-system side of symfony-dev: the development menu entry reloading the demonstration data",
  "version": "2.0.2",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyDevDs\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-design-system": ">=34.0.0",
    "wexample/symfony-dev": ">=6.0.0",
    "wexample/symfony-helpers": ">=16.0.0",
    "wexample/symfony-loader": ">=23.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": [
        "dev",
        "test"
      ]
    }
  }
}